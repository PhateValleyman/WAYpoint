{
  "format_version": "1.21.60",
  "minecraft:block": {
    "description": {
      "identifier": "voxen:waystone_top",
      "menu_category": {
        "category": "none",
        "is_hidden_in_commands": true
      },
      "states": {
        "voxen:on": [
          false,
          true
        ]
      }
    },
    "components": {
      "minecraft:geometry": "geometry.voxen_waystone_upper",
      "minecraft:collision_box": {
        "origin": [
          -7,
          0,
          -7
        ],
        "size": [
          14,
          14,
          14
        ]
      },
      "minecraft:selection_box": {
        "origin": [
          -7,
          0,
          -7
        ],
        "size": [
          14,
          14,
          14
        ]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 2.5
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 1200
      },
      "minecraft:loot": "loot_tables/empty.json",
      "minecraft:map_color": "#8a8a8a",
      "minecraft:light_dampening": 0,
      "minecraft:tick": {
        "interval_range": [
          20,
          20
        ],
        "looping": true
      },
      "minecraft:custom_components": [
        "voxen:waystone_top"
      ],
      "minecraft:material_instances": {
        "*": {
          "texture": "waystone",
          "render_method": "opaque"
        }
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('voxen:on') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "waystone_on",
              "render_method": "opaque"
            }
          },
          "minecraft:light_emission": 8
        }
      }
    ]
  }
}